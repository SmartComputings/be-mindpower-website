---
import Layout from "../layouts/Layout.astro";
import Header from "../components/common/Header.astro";

// Images
const bannerImg = "/common/chat/banner.png";
const mobileBannerImg = "/common/mobileview.png";
const phoneImg = "/common/smartphonesalud.png";

const heartIcon = "/common/heartLogo.png";
const dollarIcon = "/common/doller.png";
---

<Layout
  title="BeMind Power - Wallet"
  description="Tu billetera digital segura y conectada"
  bodyClass="wallet-detail-page"
>
  <div
    class="wallet-detail-wrap relative h-[100dvh] w-full overflow-hidden bg-[#0A0A1B]"
  >
    <Header
      currentPath="/walletdetails"
      pageTitle="Tu billetera"
      pageTitleKey="wallet.hero.titleLine1"
    />

    <main
      class="relative w-full h-[100dvh] pt-[140px] md:pt-[clamp(10rem,18vh,12rem)] md:pb-1 px-0 md:px-8 lg:px-16 flex flex-col-reverse md:flex-row items-center justify-end justify-between md:justify-center gap-auto md:gap-2 lg:gap-16 z-10 overflow-hidden"
    >
      <!-- Background Effect -->
      <div class="absolute inset-0 z-0">
        <picture>
          <source media="(max-width: 768px)" srcset={mobileBannerImg} />
          <img src={bannerImg} alt="" class="w-full h-full object-cover" />
        </picture>
      </div>

      <!-- Helper Icons (Visible on all devices) -->
      <div
        class="absolute inset-x-0 bottom-0 top-0 z-20 pointer-events-none md:hidden overflow-visible"
      >
        <!-- Heart Icon (Left) - Overlapping phone, blurred -->
        <img
          src={heartIcon}
          alt=""
          class="absolute top-[70%] max-h-[750px]:top-[65%] left-[-0px] w-20 h-auto blur-[1.9px] scale-100"
        />

        <!-- Dollar Icon (Bottom Right) - Blurred -->
        <img
          src={dollarIcon}
          alt=""
          class="absolute bottom-[-20px] right-[-20px] w-20 z-[5] h-auto blur-[3px] scale-190"
        />

        <!-- Overlay for Phone & Icons -->
        <img
          src="/common/phone-overlay.png"
          alt=""
          class="absolute bottom-[-0px] left-1/2 -translate-x-1/2 w-[150%] max-w-[600px] h-auto z-10 pointer-events-none mix-blend-screen"
        />

        <!-- Mobile Buttons -->
        <div
          class="absolute bottom-[5%] max-h-[750px]:bottom-[2%] left-0 right-0 flex flex-col items-center gap-[8px] md:hidden z-30 pointer-events-auto"
        >
          <a
            href="#"
            onclick="event.preventDefault(); window.dispatchEvent(new Event('open-coming-soon'));"
            aria-label="Download on the App Store"
            class="coming-soon-trigger apps-store-btn w-[238px] h-[30px] !bg-black/90 !border-white/20 !backdrop-blur-xl"
          >
            <img
              src="/detailPageImages/app-store-badge.svg"
              alt="Download on the App Store"
              class="h-[12px]"
            />
          </a>
          <a
            href="https://play.google.com/store/apps/details?id=chat.bemindepower.bmpchat"
            class="apps-store-btn w-[238px] h-[30px] !bg-black/90 !border-white/20 !backdrop-blur-xl"
            aria-label="Get it on Google Play"
          >
            <img
              src="/detailPageImages/google-play-badge.svg"
              alt="Get it on Google Play"
              class="h-[12px]"
            />
          </a>
        </div>
      </div>

      <!-- Left Content: Smartphone -->
      <div
        class="relative z-10 w-full flex flex-col items-center justify-end h-full md:h-auto md:justify-center mb-[-230px] max-h-[750px]:mb-[-80px] md:mb-0 transform scale-y-100 md:ml-20 lg:ml-40 origin-bottom phone-detail-container"
      >
        <div
          class="relative w-[100%] max-h-[750px]:w-[75%] md:w-[85%] lg:w-[80%] max-w-[420px] md:max-w-[480px]"
        >
          <img
            src={phoneImg}
            alt="Wallet Interface"
            class="w-full h-auto drop-shadow-2xl"
            transition:name="phone-morph-wallet"
          />
        </div>
      </div>

      <!-- Right Content: Text & Buttons -->
      <div
        class="relative z-10 w-full text-white flex flex-col items-center md:items-start ml-0 md:ml-4 lg:ml-12 mt-[clamp(20px,6vh,60px)] max-h-[750px]:mt-[40px] md:mt-0 text-left md:text-left px-6 md:px-0 md:pr-5 lg:pr-40"
      >
        <h1
          class="mb-3 max-h-[750px]:mb-2 tracking-tight text-white w-full max-w-full md:max-w-[650px] wallet-heading"
        >
          <span data-i18n="wallet.detail.title"></span>
        </h1>
        <p
          class="mb-3 max-h-[750px]:mb-1.5 max-w-lg lg:max-w-xl text-white text-[16px] max-h-[750px]:text-[14px] md:text-[20px] lg:text-[28px] md:leading-[28px] lg:leading-[34px] max-h-[750px]:leading-[20px] font-normal md:font-semibold"
          style="font-family: 'Neometric', sans-serif; letter-spacing: -0.04em;"
        >
          <span data-i18n="wallet.detail.subtitle"></span>
        </p>

        <!-- Features List -->
        <ul
          class="space-y-2 max-h-[750px]:space-y-2.5 mr-20 mb-8 max-h-[750px]:mb-3 w-[259px] md:w-full flex flex-col items-start md:items-start pl-0 md:pl-2 text-[14px] max-h-[750px]:text-[13px] leading-[100%] md:text-[16px] lg:text-[22px] md:leading-[100%]"
          style="font-family: 'Neometric', sans-serif; font-weight: 400; letter-spacing: 0;"
        >
          <li class="flex items-center gap-3 text-white lg:mb-2">
            <span class="text-white text-xl md:hidden">•</span>
            <span class="text-[#4F46E5] text-xl hidden md:inline">✓</span>
            <span data-i18n="wallet.detail.feature1"></span>
          </li>
          <li class="flex items-center gap-3 text-white lg:mb-2">
            <span class="text-white text-xl md:hidden">•</span>
            <span class="text-[#4F46E5] text-xl hidden md:inline">✓</span>
            <span data-i18n="wallet.detail.feature2"></span>
          </li>
          <li class="flex items-center gap-3 text-white">
            <span class="text-white text-xl md:hidden">•</span>
            <span class="text-[#4F46E5] text-xl hidden md:inline">✓</span>
            <span data-i18n="wallet.detail.feature3"></span>
          </li>
        </ul>
        <!-- Download Buttons -->
        <div
          class="apps-badges w-full hidden md:flex flex-col items-center md:items-center gap-6"
        >
          <a
            href="#"
            onclick="event.preventDefault(); window.dispatchEvent(new Event('open-coming-soon'));"
            aria-label="Download on the App Store"
            class="coming-soon-trigger apps-store-btn"
          >
            <img
              src="/detailPageImages/app-store-badge.svg"
              alt="Download on the App Store"
            />
          </a>
          <a
            href="https://play.google.com/store/apps/details?id=chat.bemindepower.bmpchat"
            class="apps-store-btn"
            aria-label="Get it on Google Play"
          >
            <img
              src="/detailPageImages/google-play-badge.svg"
              alt="Get it on Google Play"
            />
          </a>
        </div>
      </div>
    </main>
  </div>

  <!-- Back Arrow Icon -->
  <a
    href="/chat"
    class="back-arrow inline-flex absolute top-[90px] md:top-[120px] left-4 md:left-[5vw] lg:left-[8vw] z-[1001] text-white hover:text-[#4F46E5] transition-colors p-3 border border-transparent hover:border-[#4F46E5]/50 rounded-full bg-white/10 backdrop-blur-sm hover:bg-white/20"
  >
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M19 12H5M12 19L5 12L12 5"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </a>
</Layout>

<script>
  // Detect back arrow clicks
  document.addEventListener("click", (e) => {
    const backArrow = (e.target as HTMLElement).closest(".back-arrow");
    if (backArrow) {
      document.documentElement.setAttribute("data-nav-back", "true");

      // Disable image transition specifically for back navigation
      const phoneImg = document.querySelector(".phone-detail-container img");
      if (phoneImg) {
        (phoneImg as HTMLElement).style.viewTransitionName = "none";
      }
    }
  });
</script>

<style>
  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-15px);
    }
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  @keyframes shimmer {
    100% {
      transform: translateX(200%);
    }
  }

  .animate-shimmer {
    animation: shimmer 1.5s infinite;
  }

  .store-btn {
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
  }

  /* Apps Buttons Styles */
  @keyframes blink-shadow {
    0%,
    100% {
      box-shadow:
        0 4px 14px rgba(38, 4, 209, 0.7),
        0 -4px 14px rgba(25, 41, 255, 0.9);
    }
    50% {
      box-shadow:
        0 4px 25px rgba(38, 4, 209, 1),
        0 -4px 25px rgba(25, 41, 255, 1);
    }
  }

  .apps-store-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    background: rgba(0, 0, 0, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50px;
    box-shadow:
      0 4px 14px rgba(38, 4, 209, 0.7),
      0 -4px 14px rgba(25, 41, 255, 0.9);
    text-decoration: none;
    transition: transform 0.2s;
    animation: blink-shadow 2s infinite;
  }

  @media (min-width: 768px) {
    .apps-store-btn {
      width: 250px;
      height: 70px;
    }
    .apps-store-btn img {
      height: 50px;
    }
  }

  .apps-store-btn:hover,
  .apps-store-btn:active {
    transform: scale(1.05);
    animation: none;
    box-shadow: 0 6px 20px rgba(55, 27, 190, 0.8);
  }

  .apps-store-btn img {
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  /* Wallet Heading */
  .wallet-heading {
    width: 280px;
    font-family: "OPTIFuturaDemiBold", sans-serif;
    font-weight: 700;
    font-style: normal;
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: 0;
  }

  /* Wallet List */
  .wallet-list {
    font-family: "Neometric", sans-serif;
    font-size: 12px;
    line-height: 100%;
    font-weight: 400;
    letter-spacing: 0;
  }

  @media (min-width: 768px) {
    .apps-store-btn {
      width: 250px;
      height: 70px;
    }
    .apps-store-btn img {
      height: 50px;
    }

    .wallet-heading {
      width: 100%;
      font-family: "OPTIFutura-ExtraBlackCond", sans-serif;
      font-size: clamp(24px, 5vw, 64px);
      line-height: 1.1;
      font-weight: 500;
    }

    .wallet-list {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      font-family: "Neometric", sans-serif;
      font-size: clamp(16px, 2vw, 24px);
      line-height: 100%;
      font-weight: 400;
    }
  }

  /* ===== Tablets & Small Laptops (Landscape) ===== */
  @media (min-width: 768px) and (max-width: 1280px) {
    .wallet-heading {
      font-size: clamp(30px, 4vw, 44px) !important;
      margin-bottom: 8px !important;
    }
    .wallet-detail-wrap p {
      font-size: clamp(15px, 1.8vw, 20px) !important;
      line-height: 1.2 !important;
      margin-bottom: 10px !important;
      max-width: 80% !important;
    }
    .wallet-list {
      font-size: clamp(13px, 1.6vw, 17px) !important;
      margin-bottom: 12px !important;
    }
    .wallet-detail-wrap .apps-badges {
      gap: 12px !important;
    }
    .apps-store-btn {
      width: 190px !important;
      height: 52px !important;
    }
    .apps-store-btn img {
      height: 32px !important;
    }
    .phone-detail-container {
      max-width: 38% !important;
      margin-top: 15px !important;
      margin-left: 20px !important;
    }
  }

  /* Medium height reduction (e.g., 700px - 900px) */
  @media (min-width: 768px) and (max-height: 900px) {
    .wallet-detail-wrap main {
      padding-top: 160px !important;
    }
    .wallet-heading {
      font-size: clamp(28px, 3.5vw, 42px) !important;
    }
    .wallet-detail-wrap p {
      font-size: clamp(16px, 1.8vw, 22px) !important;
    }
    .wallet-list {
      font-size: clamp(14px, 1.6vw, 18px) !important;
      margin-bottom: 12px !important;
    }
    .phone-detail-container {
      max-width: 38% !important;
    }
  }

  /* Aggressive height reduction for short landscapes */
  @media (min-width: 768px) and (max-height: 700px) {
    .wallet-heading {
      font-size: clamp(26px, 3.5vw, 36px) !important;
      margin-bottom: 6px !important;
    }
    .wallet-detail-wrap p {
      font-size: clamp(14px, 1.6vw, 16px) !important;
      margin-bottom: 6px !important;
    }
    .wallet-list {
      font-size: clamp(12px, 1.4vw, 14px) !important;
      margin-bottom: 8px !important;
    }
    .apps-store-btn {
      width: 160px !important;
      height: 45px !important;
    }
    .apps-store-btn img {
      height: 28px !important;
    }
    .phone-detail-container {
      max-width: 32% !important;
      margin-top: 25px !important;
    }
  }

  @media (min-width: 768px) and (max-height: 600px) {
    .wallet-detail-wrap main {
      padding-top: 120px !important;
    }
  }
</style>
