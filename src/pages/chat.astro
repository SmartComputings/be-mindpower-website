---
// Página Chat: contenido específico de Chat con hero slider.
import Layout from "../layouts/Layout.astro";
import Header from "../components/common/Header.astro";
import HomeHero from "../components/home/HomeHero.astro";
import FeatureSlider from "../components/sliders/FeatureSlider.astro";
---

<Layout
  title="BeMind Power - Chat"
  description="BeMind Power: comunicación segura, instantánea e inteligente."
  bodyClass="chat-page"
>
  <div class="chat-page-wrap relative min-h-[100dvh] w-full">
    <Header
      currentPath="/chat"
      pageTitle="Todo empieza"
      pageTitleKey="chat.hero.titleLine1"
    />

    <!-- Layout Desktop: usa HomeHero con video y phone de Chat, slider inicia en Chat (index 0) -->
    <div class="chat-desktop-layout">
      <HomeHero
        transitionName="phone-morph-chat"
        videoSrc="/vedioes/an1.mp4"
        phoneSrc="/sliderImages/s1.png"
        titleLine1="Todo empieza"
        titleLine2="con una conversación"
        subtitle="Y desde ahí: paga, vende, sana o escucha música. Sin salir del chat."
        ctaText="Ver Más"
        ctaHref="/detailsPages/chatdetails"
        titleLine1Key="chat.hero.titleLine1"
        titleLine2Key="chat.hero.titleLine2"
        subtitleKey="chat.hero.subtitle"
        ctaKey="chat.hero.cta"
      >
        <FeatureSlider initialIndex={0} />
      </HomeHero>
    </div>

    <!-- Layout Mobile: estructura separada para mejor control -->
    <div class="chat-mobile-layout">
      <!-- Video de fondo -->
      <div class="chat-mobile-bg">
        <video
          id="home-hero-video"
          class="chat-mobile-video"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
        >
          <source src="/vedioes/an1.mp4" type="video/mp4" />
        </video>
        <div class="chat-mobile-overlay"></div>
        <div class="chat-mobile-glow"></div>
      </div>

      <!-- Spacer for Header Clearance -->
      <div class="chat-mobile-spacer"></div>

      <!-- Main centered content -->
      <div class="chat-mobile-main">
        <!-- Slider arriba -->
        <div class="chat-mobile-slider" id="slider">
          <FeatureSlider initialIndex={0} />
        </div>

        <!-- Contenido inferior: título + botones -->
        <div class="chat-mobile-content">
          <div class="chat-mobile-text">
            <h1 class="chat-title">
              <span
                id="hero-title-line1"
                class="chat-title-line1"
                data-i18n="chat.hero.titleLine1">Todo empieza</span
              >
              <span
                id="hero-title-line2"
                class="chat-title-line2"
                data-i18n="chat.hero.titleLine2">con una conversación</span
              >
            </h1>
            <p
              id="hero-subtitle"
              class="chat-subtitle"
              data-i18n="chat.hero.subtitle"
            >
              Y desde ahí: paga, vende, sana o escucha música. Sin salir del
              chat.
            </p>
          </div>

          <div class="chat-mobile-buttons">
            <a
              id="hero-cta-button"
              href="/detailsPages/chatdetails"
              class="chat-cta"
              data-i18n="chat.hero.cta">Ver Más</a
            >
            <div class="chat-badges">
              <a
                href="#"
                onclick="event.preventDefault(); window.dispatchEvent(new Event('open-coming-soon'));"
                aria-label="Download on the App Store"
                class="coming-soon-trigger chat-store-btn"
              >
                <img
                  src="/detailPageImages/app-store-badge.svg"
                  alt="Download on the App Store"
                />
              </a>
              <a
                href="https://play.google.com/store/apps/details?id=chat.bemindepower.bmpchat"
                class="chat-store-btn"
                aria-label="Get it on Google Play"
              >
                <img
                  src="/detailPageImages/google-play-badge.svg"
                  alt="Get it on Google Play"
                />
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  body.chat-page {
    background: #000000;
    overflow-x: hidden;
  }

  /* Desktop: mostrar layout normal, ocultar mobile */
  .chat-desktop-layout {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .chat-mobile-layout {
    display: none;
  }

  /* ===== MOBILE + TABLETS TÁCTILES ===== */
  @media screen and (max-width: 768px),
    screen and (min-width: 769px) and (max-width: 1239px) and (hover: none) and (pointer: coarse),
    screen and (min-width: 769px) and (max-width: 1239px) {
    body.chat-page {
      overflow: hidden;
      overscroll-behavior: none;
    }
    .chat-desktop-layout {
      display: none;
    }

    .chat-mobile-layout {
      position: relative;
      display: flex;
      flex-direction: column;
      width: 100%;
      height: 100dvh;
      height: 100vh;
      overflow: hidden;
      box-sizing: border-box;
      background: #0b0245;
    }

    /* Spacer for fixed Header */
    .chat-mobile-spacer {
      flex: 0 0 auto;
      height: clamp(120px, 15vh, 180px);
      width: 100%;
    }

    /* Main box that centers its children vertically */
    .chat-mobile-main {
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      width: 100%;
      min-height: 0;
      position: relative;
      z-index: 10;
      padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
    }

    .chat-mobile-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
    }
    .chat-mobile-video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
      opacity: 0.9;
    }
    .chat-mobile-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        rgba(11, 2, 69, 0.2) 0%,
        rgba(11, 2, 69, 0.6) 80%,
        rgba(11, 2, 69, 1) 100%
      );
      z-index: 1;
    }

    .chat-mobile-slider {
      width: 100%;
      height: clamp(160px, 30vh, 260px);
      margin-bottom: clamp(1rem, 3vh, 2.5rem);
      display: flex;
      align-items: center;
      justify-content: center;
      animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both;
    }

    .chat-mobile-content {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0 5%;
      gap: clamp(0.3rem, 1.2vh, 1rem);
      animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.6s both;
    }

    /* Typography & Buttons */
    .chat-title {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      margin-bottom: 0.3rem;
      gap: 0.1rem;
    }
    .chat-title-line1 {
      font-family: "OPTIFutura-ExtraBlackCond", sans-serif;
      font-size: clamp(24px, 7vw, 38px);
      font-weight: 900;
      color: #fff;
    }
    .chat-title-line2 {
      font-family: "Neometric", sans-serif;
      font-size: clamp(14px, 4vw, 22px);
      font-weight: 700;
      color: #fff;
    }
    .chat-subtitle {
      color: #fff;
      font-family: "Neometric", sans-serif;
      font-size: clamp(11px, 3.2vw, 15px);
      text-align: center;
      max-width: 90%;
      line-height: 1.3;
    }

    .chat-mobile-buttons {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.6rem;
      width: 100%;
    }
    .chat-cta {
      background: #1929ff;
      color: #fff;
      height: 44px;
      width: min(240px, 70vw);
      border-radius: 999px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      font-size: 14px;
    }
    .chat-badges {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .chat-store-btn {
      background: #000;
      border: 1px solid rgba(255, 255, 255, 0.1);
      height: 42px;
      width: min(240px, 70vw);
      border-radius: 50px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .chat-store-btn img {
      height: 26px;
    }
    .chat-mobile-slider .slider-nav {
      display: none;
    }
  }

  /* Specific Tablet Adjustments (re-applying overrides) */
  @media screen and (min-width: 769px) and (max-width: 1366px) {
    .chat-mobile-main {
      padding-bottom: 2rem;
    }
    .chat-mobile-spacer {
      height: 140px;
    }
    .chat-mobile-slider {
      height: 280px;
      margin-bottom: 2.5rem;
    }
    .chat-cta,
    .chat-store-btn {
      width: min(400px, 50vw);
    }
  }

  /* Short Screen Optimization (Landscape or Small Height) */
  @media screen and (max-height: 500px) and (max-width: 899px) {
    .chat-mobile-spacer {
      height: 80px;
    }
    .chat-mobile-main {
      flex-direction: row;
      padding-bottom: 1rem;
    }
    .chat-mobile-slider {
      width: 45%;
      height: 180px;
    }
    .chat-mobile-content {
      width: 55%;
      gap: 0.4rem;
    }
    .chat-mobile-buttons {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
    }
  }

  /* Support Button Mobile */
  @media screen and (max-width: 640px) {
    body.chat-page .support-container {
      top: 50%;
      bottom: auto;
      left: max(16px, calc(env(safe-area-inset-left) + 16px));
      transform: translateY(-50%);
    }
  }

  /* Entrance animations */
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  // Optimizar reproducción de video en mobile
  function initChatMobileVideo(): void {
    const video = document.querySelector(
      ".chat-mobile-video",
    ) as HTMLVideoElement;
    if (!video) return;

    const playVideo = () => {
      video.play().catch(() => {
        document.addEventListener(
          "touchstart",
          () => {
            video.play();
          },
          { once: true },
        );
      });
    };

    if (video.readyState >= 2) {
      playVideo();
    } else {
      video.addEventListener("loadeddata", playVideo, { once: true });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initChatMobileVideo);
  } else {
    initChatMobileVideo();
  }
</script>
