---
import Layout from "../layouts/Layout.astro";
import Header from "../components/common/Header.astro";

// Images
const bannerImg = "/common/chat/banner.png";
const mobileBannerImg = "/common/mobileview.png";
const phoneImg = "/common/chat/smartphonehome.png";

const heartIcon = "/common/heartLogo.png";
const dollarIcon = "/common/doller.png";
---

<Layout
  title="BeMind Power - Chat Details"
  description="Chat con superpoderes"
  bodyClass="chat-detail-page"
>
  <div
    class="chat-detail-wrap relative h-[100dvh] w-full overflow-hidden bg-[#0A0A1B]"
  >
    <Header
      currentPath="/chatdetails"
      pageTitle="Todo empieza"
      pageTitleKey="chat.hero.titleLine1"
    />

    <main
      class="relative w-full h-[100dvh] pt-[clamp(8rem,15vh,10rem)] md:pt-[150px] px-0 md:px-8 lg:px-16 flex flex-col-reverse md:flex-row items-center justify-end justify-between md:justify-center gap-auto md:gap-10 lg:gap-20 z-10 overflow-hidden"
    >
      <!-- Background Effect -->
      <div class="absolute inset-0 z-0">
        <picture>
          <source media="(max-width: 768px)" srcset={mobileBannerImg} />
          <img src={bannerImg} alt="" class="w-full h-full object-cover" />
        </picture>
      </div>

      <!-- Helper Icons (Mobile Only) -->
      <div
        class="absolute inset-x-0 bottom-0 top-0 z-20 pointer-events-none md:hidden overflow-visible"
      >
        <!-- Heart Icon (Left) - Overlapping phone, blurred -->
        <img
          src={heartIcon}
          alt=""
          class="absolute top-[70%] max-h-[750px]:top-[65%] left-[-0px] w-20 h-auto blur-[1.9px] scale-100"
        />

        <!-- Dollar Icon (Bottom Right) - Blurred -->
        <img
          src={dollarIcon}
          alt=""
          class="absolute bottom-[-20px] right-[-20px] w-20 z-[5] h-auto blur-[3px] scale-190"
        />

        <!-- Overlay for Phone & Icons -->
        <img
          src="/common/phone-overlay.png"
          alt=""
          class="absolute bottom-[-0px] left-1/2 -translate-x-1/2 w-[150%] max-w-[600px] h-auto z-10 pointer-events-none mix-blend-screen"
        />

        <!-- Mobile Buttons -->
        <div
          class="absolute bottom-[5%] max-h-[750px]:bottom-[2%] left-0 right-0 flex flex-col items-center gap-[8px] md:hidden z-30 pointer-events-auto"
        >
          <!-- Mobile Back Button -->
          <a
            href="/chat"
            class="back-mobile-btn w-[238px] h-[35px] md:hidden bg-[#1D4ED8] hover:bg-[#1E40AF] text-white rounded-[50px] flex items-center justify-center font-bold text-[14px] mb-2 transition-colors shadow-[0_0_15px_rgba(29,78,216,0.6)] border border-white/10"
            data-i18n="back.button"
          >
            Atrás
          </a>
          <a
            href="#"
            onclick="event.preventDefault(); window.dispatchEvent(new Event('open-coming-soon'));"
            aria-label="Download on the App Store"
            class="coming-soon-trigger apps-store-btn w-[238px] h-[30px] !bg-black/90 !border-white/20 !backdrop-blur-xl"
          >
            <img
              src="/detailPageImages/app-store-badge.svg"
              alt="Download on the App Store"
              class="h-[12px]"
            />
          </a>
          <a
            href="https://play.google.com/store/apps/details?id=chat.bemindepower.bmpchat"
            class="apps-store-btn w-[238px] h-[30px] !bg-black/90 !border-white/20 !backdrop-blur-xl"
            aria-label="Get it on Google Play"
          >
            <img
              src="/detailPageImages/google-play-badge.svg"
              alt="Get it on Google Play"
              class="h-[12px]"
            />
          </a>
        </div>
      </div>

      <!-- Left Content: Smartphone -->
      <div
        class="relative z-10 w-full flex flex-col items-center justify-end h-full md:h-auto md:justify-center mb-[clamp(-250px,-30vh,-50px)] max-h-[750px]:mb-[clamp(-150px,-20vh,-20px)] md:mb-0 transform scale-y-100 mt-0 md:mt-[clamp(2rem,6vh,5rem)] origin-bottom phone-detail-container"
      >
        <div
          class="relative w-[100%] max-h-[750px]:w-[80%] md:w-full max-w-[500px] md:max-w-[400px] 2xl:max-w-[550px]"
        >
          <img
            src={phoneImg}
            alt="App Interface"
            class="w-full h-auto drop-shadow-2xl"
            transition:name="phone-morph-chat"
          />
        </div>
      </div>

      <!-- Right Content: Text & Buttons -->
      <div
        class="relative z-10 w-full md:max-w-xl lg:max-w-2xl text-white flex flex-col items-start md:items-start mr-0 md:mr-10 lg:mr-0 mt-[clamp(20px,6vh,60px)] max-h-[750px]:mt-6 md:mt-0 text-left md:text-left px-6 md:px-0 md:pr-5 lg:pr-60"
      >
        <h1
          class="mb-4 tracking-tight text-white w-full max-w-full md:max-w-full text-[28px] leading-[36px] md:text-[32px] lg:text-[48px] 2xl:text-[64px] md:leading-[38px] lg:leading-[52px] 2xl:leading-[64px] font-bold md:font-medium"
          style="font-family: 'OPTIFutura-ExtraBlackCond', sans-serif; letter-spacing: 0;"
        >
          <span data-i18n="chat.detail.title"
            >Imagina tu chat con superpoderes</span
          >
        </h1>

        <p
          class="mb-6 max-w-full md:max-w-lg lg:max-w-xl text-white text-[18px] md:text-[20px] lg:text-[24px] 2xl:text-[32px] md:leading-[24px] lg:leading-[30px] 2xl:leading-[39px] font-normal md:font-semibold"
          style="font-family: 'Neometric', sans-serif; letter-spacing: -0.04em;"
        >
          <span data-i18n="chat.detail.subtitle"
            >No solo escribes: compartes fotos, llamas, mandas archivos y hasta
            dinero sin salir de la conversación.</span
          >
        </p>

        <ul
          class="mb-8 w-full flex flex-col items-start md:items-start pl-0 md:pl-2 text-[14px] leading-[100%] md:text-[16px] lg:text-[18px] 2xl:text-[24px] md:leading-[100%]"
          style="font-family: 'Neometric', sans-serif; font-weight: 400; letter-spacing: 0;"
        >
          <li class="flex items-center gap-3 text-white">
            <span class="text-white text-xl md:hidden">•</span>
            <span class="text-white text-xl hidden md:inline">✔</span>
            <span data-i18n="chat.detail.feature1"
              >Chats privados y seguros</span
            >
          </li>
          <li class="flex items-center gap-3 text-white">
            <span class="text-white text-xl md:hidden">•</span>
            <span class="text-white text-xl hidden md:inline">✔</span>
            <span data-i18n="chat.detail.feature2">Pagos en el mismo chat</span>
          </li>
          <li class="flex items-center gap-3 text-white">
            <span class="text-white text-xl md:hidden">•</span>
            <span class="text-white text-xl hidden md:inline">✔</span>
            <span data-i18n="chat.detail.feature3"
              >Llamadas y videollamadas HD</span
            >
          </li>
          <li class="flex items-center gap-3 text-white">
            <span class="text-white text-xl md:hidden">•</span>
            <span class="text-white text-xl hidden md:inline">✔</span>
            <span data-i18n="chat.detail.feature4"
              >Grupos con miles de miembros</span
            >
          </li>
        </ul>

        <!-- Download Buttons -->
        <div
          class="apps-badges w-full hidden md:flex flex-col items-center md:items-center gap-6"
        >
          <a
            href="#"
            onclick="event.preventDefault(); window.dispatchEvent(new Event('open-coming-soon'));"
            aria-label="Download on the App Store"
            class="coming-soon-trigger apps-store-btn"
          >
            <img
              src="/detailPageImages/app-store-badge.svg"
              alt="Download on the App Store"
            />
          </a>
          <a
            href="https://play.google.com/store/apps/details?id=chat.bemindepower.bmpchat"
            class="apps-store-btn"
            aria-label="Get it on Google Play"
          >
            <img
              src="/detailPageImages/google-play-badge.svg"
              alt="Get it on Google Play"
            />
          </a>
        </div>
      </div>
    </main>

    <!-- Back Arrow Icon -->
    <a
      href="/chat"
      class="back-arrow hidden md:inline-flex absolute md:top-[280px] md:left-[8vw] lg:left-[12vw] z-[1001] text-white hover:text-[#4F46E5] transition-colors p-3 border border-transparent hover:border-[#4F46E5]/50 rounded-full bg-white/10 backdrop-blur-sm hover:bg-white/20"
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M19 12H5M12 19L5 12L12 5"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>
</Layout>

<style>
  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-15px);
    }
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  @keyframes shimmer {
    100% {
      transform: translateX(200%);
    }
  }

  .animate-shimmer {
    animation: shimmer 1.5s infinite;
  }

  .store-btn {
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
  }

  /* Apps Buttons Styles */
  @keyframes blink-shadow {
    0%,
    100% {
      box-shadow:
        0 4px 14px rgba(38, 4, 209, 0.7),
        0 -4px 14px rgba(25, 41, 255, 0.9);
    }
    50% {
      box-shadow:
        0 4px 25px rgba(38, 4, 209, 1),
        0 -4px 25px rgba(25, 41, 255, 1);
    }
  }

  .apps-store-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    background: rgba(0, 0, 0, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50px;
    box-shadow:
      0 4px 14px rgba(38, 4, 209, 0.7),
      0 -4px 14px rgba(25, 41, 255, 0.9);
    text-decoration: none;
    transition: transform 0.2s;
    animation: blink-shadow 2s infinite;
  }

  @media (min-width: 768px) {
    .apps-store-btn {
      width: 250px;
      height: 70px;
    }
    .apps-store-btn img {
      height: 50px;
    }
  }

  .apps-store-btn:hover,
  .apps-store-btn:active {
    transform: scale(1.05);
    animation: none;
    box-shadow: 0 6px 20px rgba(55, 27, 190, 0.8);
  }

  .apps-store-btn img {
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  /* ===== Tablets & Small Laptops (Landscape) ===== */
  @media (min-width: 768px) and (max-width: 1280px) {
    .chat-detail-wrap h1 {
      font-size: clamp(32px, 4.5vw, 48px) !important;
      line-height: 1.1 !important;
      margin-bottom: 12px !important;
    }
    .chat-detail-wrap p {
      font-size: clamp(16px, 2vw, 22px) !important;
      line-height: 1.2 !important;
      margin-bottom: 12px !important;
      max-width: 85% !important;
    }
    .chat-detail-wrap ul {
      font-size: clamp(14px, 1.8vw, 18px) !important;
      margin-bottom: 15px !important;
    }
    .chat-detail-wrap .apps-badges {
      gap: 12px !important;
    }
    .apps-store-btn {
      width: 200px !important;
      height: 55px !important;
    }
    .apps-store-btn img {
      height: 35px !important;
    }
    .phone-detail-container {
      max-width: 40% !important;
      margin-top: 20px !important;
    }
  }

  /* Medium height reduction (e.g., 700px - 900px) */
  @media (min-width: 768px) and (max-height: 900px) {
    .chat-detail-wrap main {
      padding-top: 130px !important;
    }
    .chat-detail-wrap h1 {
      font-size: clamp(32px, 4vw, 54px) !important;
    }
    .chat-detail-wrap p {
      font-size: clamp(18px, 2.2vw, 26px) !important;
    }
    .chat-detail-wrap ul {
      font-size: clamp(16px, 1.8vw, 20px) !important;
      margin-bottom: 20px !important;
    }
    .phone-detail-container {
      max-width: 45% !important;
    }
  }

  /* Aggressive height reduction for short landscapes */
  @media (min-width: 768px) and (max-height: 700px) {
    .chat-detail-wrap main {
      padding-top: 100px !important;
    }
    .chat-detail-wrap h1 {
      font-size: clamp(28px, 4vw, 36px) !important;
      margin-bottom: 8px !important;
    }
    .chat-detail-wrap p {
      font-size: clamp(14px, 1.8vw, 18px) !important;
      margin-bottom: 8px !important;
    }
    .chat-detail-wrap ul {
      font-size: clamp(13px, 1.6vw, 15px) !important;
      margin-bottom: 10px !important;
    }
    .apps-store-btn {
      width: 160px !important;
      height: 45px !important;
    }
    .apps-store-btn img {
      height: 28px !important;
    }
    .phone-detail-container {
      max-width: 35% !important;
      margin-top: 40px !important;
    }
  }

  @media (min-width: 768px) and (max-height: 600px) {
    .chat-detail-wrap main {
      padding-top: 100px !important;
    }
  }

  /* ===== iPhone SE & small screens ===== */
  @media (max-width: 768px) and (max-height: 680px) {
    /* Shrink heading */
    .chat-detail-wrap h1 {
      font-size: 22px !important;
      line-height: 28px !important;
      margin-bottom: 6px !important;
    }

    /* Shrink subtitle */
    .chat-detail-wrap p {
      font-size: 13px !important;
      line-height: 1.4 !important;
      margin-bottom: 6px !important;
    }

    /* Shrink feature list */
    .chat-detail-wrap ul {
      font-size: 12px !important;
      margin-bottom: 6px !important;
    }

    /* Shrink phone image */
    .chat-detail-wrap main > div:first-of-type div {
      max-width: 65% !important;
    }

    /* Reduce phone negative margin pull */
    .chat-detail-wrap main > div:first-of-type {
      margin-bottom: -80px !important;
    }
  }
</style>
