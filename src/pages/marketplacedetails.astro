---
import Layout from "../layouts/Layout.astro";
import Header from "../components/common/Header.astro";

// Images
const bannerImg = "/common/chat/banner.png";
const mobileBannerImg = "/common/mobileview.png";
const phoneImg = "/common/smartphone3 1.png";
const googlePlay = "/common/chat/googleplay.png";
const appleStore = "/common/chat/apple.png";

const heartIcon = "/common/heartLogo.png";
const dollarIcon = "/common/doller.png";
---

<Layout
  title="BeMind Power - Marketplace Details"
  description="Todo lo que quieras en un solo mercado"
  bodyClass="marketplace-detail-page"
>
  <div
    class="marketplace-detail-wrap relative h-[100dvh] w-full overflow-hidden bg-[#0A0A1B]"
  >
    <Header
      currentPath="/marketplacedetails"
      pageTitle="Todo lo que quieras"
      pageTitleKey="marketplace.hero.titleLine1"
    />

    <main
      class="relative w-full h-[100dvh] pt-[70px] md:pt-[180px] px-0 md:px-8 lg:px-16 flex flex-col-reverse md:flex-row items-center justify-end justify-between md:justify-center gap-auto md:gap-10 lg:gap-20 z-10 overflow-hidden"
    >
      <!-- Background Effect -->
      <div class="absolute inset-0 z-0">
        <picture>
          <source media="(max-width: 768px)" srcset={mobileBannerImg} />
          <img src={bannerImg} alt="" class="w-full h-full object-cover" />
        </picture>
      </div>

      <!-- Helper Icons (Mobile Only) -->
      <div
        class="absolute inset-x-0 bottom-0 top-0 z-20 pointer-events-none md:hidden overflow-visible"
      >
        <!-- Heart Icon (Left) - Overlapping phone, blurred -->
        <img
          src={heartIcon}
          alt=""
          class="absolute top-[70%] max-h-[750px]:top-[65%] left-[-0px] w-20 h-auto blur-[1.9px] scale-100"
        />

        <!-- Dollar Icon (Bottom Right) - Blurred -->
        <img
          src={dollarIcon}
          alt=""
          class="absolute bottom-[-20px] right-[-20px] w-20 z-[5] h-auto blur-[3px] scale-190"
        />

        <!-- Overlay for Phone & Icons -->
        <img
          src="/common/phone-overlay.png"
          alt=""
          class="absolute bottom-[-0px] left-1/2 -translate-x-1/2 w-[150%] max-w-[600px] h-auto z-10 pointer-events-none mix-blend-screen"
        />

        <!-- Mobile Buttons -->
        <div
          class="absolute bottom-[5%] max-h-[750px]:bottom-[2%] left-0 right-0 flex flex-col items-center gap-[8px] md:hidden z-30 pointer-events-auto"
        >
          <!-- Mobile Back Button -->
          <a
            href="/chat"
            class="back-mobile-btn w-[238px] h-[35px] md:hidden bg-[#1D4ED8] hover:bg-[#1E40AF] text-white rounded-[50px] flex items-center justify-center font-bold text-[14px] mb-2 transition-colors shadow-[0_0_15px_rgba(29,78,216,0.6)] border border-white/10"
            data-i18n="back.button"
          >
            Atrás
          </a>
          <a
            href="#"
            onclick="event.preventDefault(); window.dispatchEvent(new Event('open-coming-soon'));"
            aria-label="Download on the App Store"
            class="coming-soon-trigger apps-store-btn w-[238px] h-[30px] !bg-black/90 !border-white/20 !backdrop-blur-xl"
          >
            <img
              src="/detailPageImages/app-store-badge.svg"
              alt="Download on the App Store"
              class="h-[12px]"
            />
          </a>
          <a
            href="https://play.google.com/store/apps/details?id=chat.bemindepower.bmpchat"
            class="apps-store-btn w-[238px] h-[30px] !bg-black/90 !border-white/20 !backdrop-blur-xl"
            aria-label="Get it on Google Play"
          >
            <img
              src="/detailPageImages/google-play-badge.svg"
              alt="Get it on Google Play"
              class="h-[12px]"
            />
          </a>
        </div>
      </div>

      <!-- Left Content: Smartphone -->
      <div
        class="relative z-10 w-full flex flex-col items-center justify-end h-full md:h-auto md:justify-center mb-[clamp(-250px,-30vh,-50px)] max-h-[750px]:mb-[clamp(-150px,-20vh,-20px)] md:mb-0 transform scale-y-100 mt-0 md:mt-[clamp(2rem,6vh,5rem)] origin-bottom phone-detail-container"
      >
        <div
          class="relative w-[130%] max-h-[750px]:w-[110%] md:w-[100%] lg:w-[100%] md:max-w-[520px]"
        >
          <img
            src={phoneImg}
            alt="Marketplace Interface"
            class="w-full h-auto drop-shadow-2xl"
            transition:name="phone-morph-marketplace"
          />
        </div>
      </div>

      <!-- Right Content: Text & Buttons -->
      <div
        class="relative z-10 w-full md:max-w-xl lg:max-w-2xl text-white flex flex-col items-start md:items-start ml-0 md:ml-4 lg:ml-12 mr-0 md:mr-10 lg:mr-0 mt-0 md:mt-0 text-left md:text-left px-6 md:px-0"
      >
        <h1
          class="mb-6 max-h-[750px]:mb-2 tracking-tight text-white ml-8 md:ml-0 marketplace-heading"
        >
          <span data-i18n="marketplace.detail.title"
            >Todo lo que quieras, en un solo mercado.</span
          >
        </h1>

        <p
          class="mb-8 max-h-[750px]:mb-3 max-w-xl text-white ml-8 md:ml-0 marketplace-subtitle"
        >
          <span data-i18n="marketplace.detail.subtitle"
            >Desde un celular hasta comida a domicilio. Compra con confianza,
            con pagos rápidos y sin comisiones ocultas.</span
          >
        </p>
        <!-- Features List -->
        <ul
          class="space-y-1 max-h-[750px]:space-y-1.5 mb-16 max-h-[750px]:mb-3 w-full md:w-full flex flex-col items-start md:items-start pl-0 md:pl-2 text-[14px] max-h-[750px]:text-[13px] leading-[100%] md:text-[16px] lg:text-[22px] md:leading-[100%]"
          style="font-family: 'Neometric', sans-serif; font-weight: 400; letter-spacing: 0;"
        >
          <li class="flex items-center gap-3 text-white">
            <span class="text-white text-xl md:hidden">•</span>
            <span class="text-[#4F46E5] text-xl hidden md:inline">✓</span>
            <span data-i18n="marketplace.detail.feature1"></span>
          </li>
          <li class="flex items-center gap-3 text-white">
            <span class="text-white text-xl md:hidden">•</span>
            <span class="text-[#4F46E5] text-xl hidden md:inline">✓</span>
            <span data-i18n="marketplace.detail.feature2"></span>
          </li>
          <li class="flex items-center gap-3 text-white">
            <span class="text-white text-xl md:hidden">•</span>
            <span class="text-[#4F46E5] text-xl hidden md:inline">✓</span>
            <span data-i18n="marketplace.detail.feature3"></span>
          </li>
          <li class="flex items-center gap-3 text-white">
            <span class="text-white text-xl md:hidden">•</span>
            <span class="text-[#4F46E5] text-xl hidden md:inline">✓</span>
            <span data-i18n="marketplace.detail.feature4"></span>
          </li>
        </ul>

        <!-- Download Buttons -->
        <div
          class="apps-badges w-full hidden md:flex flex-col items-center md:items-center gap-6"
        >
          <a
            href="#"
            onclick="event.preventDefault(); window.dispatchEvent(new Event('open-coming-soon'));"
            aria-label="Download on the App Store"
            class="coming-soon-trigger apps-store-btn"
          >
            <img
              src="/detailPageImages/app-store-badge.svg"
              alt="Download on the App Store"
            />
          </a>
          <a
            href="https://play.google.com/store/apps/details?id=chat.bemindepower.bmpchat"
            class="apps-store-btn"
            aria-label="Get it on Google Play"
          >
            <img
              src="/detailPageImages/google-play-badge.svg"
              alt="Get it on Google Play"
            />
          </a>
        </div>
      </div>
    </main>

    <!-- Back Arrow Icon -->
    <a
      href="/chat"
      class="back-arrow hidden md:inline-flex absolute md:top-[280px] md:left-[8vw] lg:left-[12vw] z-[1001] text-white hover:text-[#4F46E5] transition-colors p-3 border border-transparent hover:border-[#4F46E5]/50 rounded-full bg-white/10 backdrop-blur-sm hover:bg-white/20"
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M19 12H5M12 19L5 12L12 5"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>
</Layout>

<script>
  // Detect back arrow clicks
  document.addEventListener("click", (e) => {
    const backArrow = (e.target as HTMLElement).closest(".back-arrow");
    if (backArrow) {
      document.documentElement.setAttribute("data-nav-back", "true");

      // Disable image transition specifically for back navigation
      const phoneImg = document.querySelector(".phone-detail-container img");
      if (phoneImg) {
        (phoneImg as HTMLElement).style.viewTransitionName = "none";
      }
    }
  });
</script>

<style>
  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-15px);
    }
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  @keyframes shimmer {
    100% {
      transform: translateX(200%);
    }
  }

  .animate-shimmer {
    animation: shimmer 1.5s infinite;
  }

  .store-btn {
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
  }

  /* Apps Buttons Styles */
  @keyframes blink-shadow {
    0%,
    100% {
      box-shadow:
        0 4px 14px rgba(38, 4, 209, 0.7),
        0 -4px 14px rgba(25, 41, 255, 0.9);
    }
    50% {
      box-shadow:
        0 4px 25px rgba(38, 4, 209, 1),
        0 -4px 25px rgba(25, 41, 255, 1);
    }
  }

  .apps-store-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    background: rgba(0, 0, 0, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50px;
    box-shadow:
      0 4px 14px rgba(38, 4, 209, 0.7),
      0 -4px 14px rgba(25, 41, 255, 0.9);
    text-decoration: none;
    transition: transform 0.2s;
    animation: blink-shadow 2s infinite;
  }

  @media (min-width: 768px) {
    .apps-store-btn {
      width: 250px;
      height: 70px;
    }
    .apps-store-btn img {
      height: 50px;
    }
  }

  .apps-store-btn:hover,
  .apps-store-btn:active {
    transform: scale(1.05);
    animation: none;
    box-shadow: 0 6px 20px rgba(55, 27, 190, 0.8);
  }

  .apps-store-btn img {
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .marketplace-heading {
    font-family: "OPTIFutura-ExtraBlackCond", sans-serif;
    font-size: clamp(24px, 5vw, 64px);
    line-height: 1.1;
    font-weight: 500;
    letter-spacing: 0;
  }

  .marketplace-subtitle {
    font-family: "Neometric", sans-serif;
    font-size: clamp(14px, 3vw, 32px);
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  /* ===== Tablets & Small Laptops (Landscape) ===== */
  @media (min-width: 768px) and (max-width: 1280px) {
    .marketplace-heading {
      font-size: clamp(30px, 4vw, 44px) !important;
      line-height: 1.1 !important;
      margin-bottom: 12px !important;
    }
    .marketplace-subtitle {
      font-size: clamp(15px, 1.8vw, 20px) !important;
      line-height: 1.2 !important;
      margin-bottom: 10px !important;
    }
    .marketplace-detail-wrap ul {
      font-size: clamp(13px, 1.6vw, 17px) !important;
      margin-bottom: 12px !important;
      gap: 5px !important;
    }
    .marketplace-detail-wrap .apps-badges {
      gap: 12px !important;
    }
    .apps-store-btn {
      width: 190px !important;
      height: 52px !important;
    }
    .apps-store-btn img {
      height: 32px !important;
    }
    .phone-detail-container {
      max-width: 40% !important;
      margin-top: 20px !important;
    }
    .phone-detail-container > div {
      width: 100% !important;
    }
  }

  /* Medium height reduction (e.g., 700px - 900px) */
  @media (min-width: 768px) and (max-height: 900px) {
    .marketplace-detail-wrap main {
      padding-top: 160px !important;
    }
    .marketplace-heading {
      font-size: clamp(28px, 3.5vw, 48px) !important;
    }
    .marketplace-list {
      font-size: clamp(14px, 1.6vw, 18px) !important;
      margin-bottom: 12px !important;
    }
    .phone-detail-container {
      max-width: 38% !important;
    }
  }

  /* Aggressive height reduction for short landscapes */
  @media (min-width: 768px) and (max-height: 700px) {
    .marketplace-heading {
      font-size: clamp(26px, 3.5vw, 36px) !important;
      margin-bottom: 8px !important;
    }
    .marketplace-subtitle {
      font-size: clamp(14px, 1.6vw, 16px) !important;
      margin-bottom: 8px !important;
    }
    .marketplace-detail-wrap ul {
      font-size: clamp(12px, 1.4vw, 14px) !important;
      margin-bottom: 10px !important;
    }
    .apps-store-btn {
      width: 160px !important;
      height: 45px !important;
    }
    .apps-store-btn img {
      height: 28px !important;
    }
    .phone-detail-container {
      max-width: 35% !important;
      margin-top: 25px !important;
    }
  }

  @media (min-width: 768px) and (max-height: 600px) {
    .marketplace-detail-wrap main {
      padding-top: 120px !important;
    }
  }
</style>
