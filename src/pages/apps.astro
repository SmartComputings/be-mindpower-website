---
import Layout from "../layouts/Layout.astro";
import Header from "../components/common/Header.astro";
import HomeHero from "../components/home/HomeHero.astro";
import FeatureSlider from "../components/sliders/FeatureSlider.astro";
---

<Layout
  title="BeMind Power - Apps"
  description="BeMind Power: Una sola puerta a cientos de soluciones."
  bodyClass="apps-page"
>
  <div class="apps-page-wrap relative min-h-[100dvh] w-full">
    <Header
      currentPath="/apps"
      pageTitle="Una sola app"
      pageTitleKey="apps.hero.titleLine1"
    />

    <!-- Layout Desktop: uses HomeHero with video and Apps phone, slider starts at Apps (index 3) -->
    <div class="apps-desktop-layout">
      <HomeHero
        transitionName="phone-morph-apps"
        videoSrc="/vedioes/an4.mp4"
        phoneSrc="/sliderImages/s4.png"
        titleLine1="Una sola app"
        titleLine2="Cientos de soluciones"
        subtitle="Una sola puerta a cientos de soluciones. Accede a todas las apps que necesitas desde un solo lugar."
        ctaText="Ver Más"
        ctaHref="/detailsPages/appsdetails"
        titleLine1Key="apps.hero.titleLine1"
        titleLine2Key="apps.hero.titleLine2"
        subtitleKey="apps.hero.subtitle"
        ctaKey="apps.hero.cta"
      >
        <FeatureSlider initialIndex={3} />
      </HomeHero>
    </div>

    <!-- Layout Mobile: estructura separada para mejor control -->
    <div class="apps-mobile-layout">
      <!-- Video de fondo (o imagen de fondo si no hay video específico) -->
      <div class="apps-mobile-bg">
        <div class="apps-mobile-overlay"></div>
        <div class="apps-mobile-glow"></div>
      </div>

      <!-- Spacer for Header Clearance -->
      <div class="apps-mobile-spacer"></div>

      <!-- Main centered content -->
      <div class="apps-mobile-main">
        <!-- Slider arriba -->
        <div class="apps-mobile-slider" id="slider">
          <FeatureSlider initialIndex={3} />
        </div>

        <!-- Contenido inferior: título + botones -->
        <div class="apps-mobile-content">
          <div class="apps-mobile-text">
            <h1 class="apps-title">
              <span
                id="hero-title-line1"
                class="apps-title-line1"
                data-i18n="apps.hero.titleLine1">Una sola app</span
              >
              <span
                id="hero-title-line2"
                class="apps-title-line2"
                data-i18n="apps.hero.titleLine2">Cientos de soluciones</span
              >
            </h1>
            <p
              id="hero-subtitle"
              class="apps-subtitle"
              data-i18n="apps.hero.subtitle"
            >
              Una sola puerta a cientos de soluciones. Accede a todas las apps que necesitas desde un solo lugar.
            </p>
          </div>

          <div class="apps-mobile-buttons">
            <a
              id="hero-cta-button"
              href="/detailsPages/appsdetails"
              class="apps-cta"
              data-i18n="apps.hero.cta">Ver Más</a
            >
            <div class="apps-badges">
              <a
                href="#"
                onclick="event.preventDefault(); window.dispatchEvent(new Event('open-coming-soon'));"
                aria-label="Download on the App Store"
                class="coming-soon-trigger apps-store-btn"
              >
                <img
                  src="/detailPageImages/app-store-badge.svg"
                  alt="Download on the App Store"
                />
              </a>
              <a
                href="https://play.google.com/store/apps/details?id=chat.bemindepower.bmpchat"
                class="apps-store-btn"
                aria-label="Get it on Google Play"
              >
                <img
                  src="/detailPageImages/google-play-badge.svg"
                  alt="Get it on Google Play"
                />
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  body.apps-page {
    background: #000000;
    overflow-x: hidden;
  }

  /* Desktop: show normal layout, hide mobile */
  .apps-desktop-layout {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .apps-mobile-layout {
    display: none;
  }

  /* ===== MOBILE + TABLETS TACTILE ===== */
  @media screen and (max-width: 768px),
    screen and (min-width: 769px) and (max-width: 1239px) and (hover: none) and (pointer: coarse),
    screen and (min-width: 769px) and (max-width: 1239px) {
    body.apps-page {
      overflow: hidden;
      overscroll-behavior: none;
    }
    .apps-desktop-layout {
      display: none;
    }

    .apps-mobile-layout {
      position: relative;
      display: flex;
      flex-direction: column;
      width: 100%;
      height: 100dvh;
      height: 100vh;
      overflow: hidden;
      box-sizing: border-box;
      background: #0b0245;
    }

  /* Spacer for fixed Header */
  .apps-mobile-spacer {
    flex: 0 0 auto;
    height: clamp(120px, 15vh, 180px);
    width: 100%;
  }

  /* Main box that centers its children vertically */
  .apps-mobile-main {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    min-height: 0;
    position: relative;
    z-index: 10;
    padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
  }

  .apps-mobile-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url("/common/welcomebg.png");
    background-size: cover;
    background-position: center top;
  }
  .apps-mobile-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(11, 2, 69, 0.2) 0%,
      rgba(11, 2, 69, 0.6) 80%,
      rgba(11, 2, 69, 1) 100%
    );
    z-index: 1;
  }

  .apps-mobile-slider {
    width: 100%;
    height: clamp(160px, 30vh, 260px);
    margin-bottom: clamp(2.5rem, 8vh, 5.5rem);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both;
  }

  .apps-mobile-content {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 5%;
    gap: clamp(0.3rem, 1.2vh, 1rem);
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.6s both;
  }

  /* Typography & Buttons */
  .apps-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 0.3rem;
    gap: 0.1rem;
  }
  .apps-title-line1 {
    font-family: "OPTIFutura-ExtraBlackCond", sans-serif;
    font-size: clamp(24px, 7vw, 38px);
    font-weight: 900;
    color: #fff;
  }
  .apps-title-line2 {
    font-family: "Neometric", sans-serif;
    font-size: clamp(14px, 4vw, 22px);
    font-weight: 700;
    color: #fff;
  }
  .apps-subtitle {
    color: #fff;
    font-family: "Neometric", sans-serif;
    font-size: clamp(11px, 3.2vw, 15px);
    text-align: center;
    max-width: 90%;
    line-height: 1.3;
  }

  .apps-mobile-buttons {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
  }
  .apps-cta {
    background: #1929ff;
    color: #fff;
    height: 44px;
    width: min(240px, 70vw);
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-size: 14px;
  }
  .apps-badges {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .apps-store-btn {
    background: #000;
    border: 1px solid rgba(255, 255, 255, 0.1);
    height: 42px;
    width: min(240px, 70vw);
    border-radius: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .apps-store-btn img {
    height: 26px;
  }
}

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
