---
import Header from "../components/common/Header.astro";
import Layout from "../layouts/Layout.astro";

// Images
const bannerImg = "/common/chat/banner.png";
const mobileBannerImg = "/common/mobileview.png";
const phoneImg = "/common/aifinance.png";
const googlePlay = "/common/chat/googleplay.png";
const appleStore = "/common/chat/apple.png";

const heartIcon = "/common/heartLogo.png";
const dollarIcon = "/common/doller.png";
---

<Layout
  title="BeMind Power - AI Finance"
  description="Smart financial management"
  bodyClass="finance-detail-page"
>
  <div
    class="chat-detail-wrap relative h-[100dvh] w-full overflow-hidden bg-[#0A0A1B]"
  >
    <Header
      currentPath="/financedetails"
      pageTitle="Finanzas inteligentes"
      pageTitleKey="finance.hero.titleLine1"
    />

    <main
      class="relative w-full h-[100dvh] pt-28 max-h-[750px]:pt-20 md:pt-4 px-0 md:px-8 lg:px-16 flex flex-col-reverse md:flex-row items-center justify-end md:justify-center gap-auto md:gap-20 z-10 overflow-hidden"
    >
      <!-- Background Effect -->
      <div class="absolute inset-0 z-0">
        <picture>
          <source media="(max-width: 768px)" srcset={mobileBannerImg} />
          <img src={bannerImg} alt="" class="w-full h-full object-cover" />
        </picture>
      </div>

      <!-- Helper Icons (Mobile Only) -->
      <div
        class="absolute inset-x-0 bottom-0 top-0 z-20 pointer-events-none md:hidden overflow-visible"
      >
        <!-- Heart Icon (Left) - Overlapping phone, blurred -->
        <img
          src={heartIcon}
          alt=""
          class="absolute top-[70%] max-h-[750px]:top-[65%] left-[-0px] w-20 h-auto blur-[1.9px] scale-100"
        />

        <!-- Dollar Icon (Bottom Right) - Blurred -->
        <img
          src={dollarIcon}
          alt=""
          class="absolute bottom-[-20px] right-[-20px] w-20 z-[5] h-auto blur-[3px] scale-190"
        />

        <!-- Overlay for Phone & Icons -->
        <img
          src="/common/phone-overlay.png"
          alt=""
          class="absolute bottom-[-0px] left-1/2 -translate-x-1/2 w-[150%] max-w-[600px] h-auto z-10 pointer-events-none mix-blend-screen"
        />

                <!-- Mobile Buttons -->
        <div
          class="absolute bottom-[5%] max-h-[750px]:bottom-[2%] left-0 right-0 flex flex-col items-center gap-[8px] md:hidden z-30 pointer-events-auto"
        >
          <a href="#" onclick="event.preventDefault(); window.dispatchEvent(new Event('open-coming-soon'));" aria-label="Download on the App Store" class="coming-soon-trigger apps-store-btn w-[238px] h-[30px] !bg-black/90 !border-white/20 !backdrop-blur-xl" >
            <img
              src="/detailPageImages/app-store-badge.svg"
              alt="Download on the App Store"
              class="h-[12px]"
            />
          </a>
          <a
            href="https://play.google.com/store/apps/details?id=chat.bemindepower.bmpchat"
            class="apps-store-btn w-[238px] h-[30px] !bg-black/90 !border-white/20 !backdrop-blur-xl"
            aria-label="Get it on Google Play"
          >
            <img
              src="/detailPageImages/google-play-badge.svg"
              alt="Get it on Google Play"
              class="h-[12px]"
            />
          </a>
        </div>
      </div>

      <!-- Left Content: Smartphone -->
      <div
        class="relative z-10 w-full flex flex-col items-center md:mt-20 justify-end h-full md:h-auto md:justify-center mb-[-230px] max-h-[750px]:mb-[-50px] md:mb-0 transform scale-y-100 origin-bottom phone-detail-container"
      >
        <div
          class="relative w-[115%] max-h-[750px]:w-[100%] md:w-[85%] lg:w-[80%] md:max-w-[500px]"
        >
          <img
            src={phoneImg}
            alt="App Interface"
            class="w-full h-auto drop-shadow-2xl" transition:name="phone-morph-finance"
          />
        </div>
      </div>

      <!-- Right Content: Text & Buttons -->
      <div
        class="relative z-10 w-full md:max-w-2xl text-white flex flex-col items-center md:items-start ml-30 md:ml-0 mt-[30px] max-h-[750px]:mt-6 md:mt-0 text-left md:text-left px-6 mr-40 md:px-0"
      >
        <h1 class="mb-6 tracking-tight text-white ai-finance-heading">
          <span data-i18n="finance.detail.title"
            >Smart financial management at your fingertips.</span
          >
        </h1>

        <!-- Features List -->
        <ul
          class="space-y-1 md:space-y-3 mb-8 w-[259px] md:w-full flex flex-col items-start md:items-start pl-0 md:pl-2 text-[12px] leading-[100%] md:text-[18px] lg:text-[24px]"
          style="font-family: 'Neometric', sans-serif; font-weight: 400; letter-spacing: 0;"
        >
          <li class="flex items-center gap-3 text-white">
            <span class="text-white text-xl md:hidden">•</span>
            <span class="text-[#4F46E5] text-xl hidden md:inline">✓</span>
            <span data-i18n="finance.detail.feature1"
              >AI-powered expense tracking</span
            >
          </li>
          <li class="flex items-center gap-3 text-white">
            <span class="text-white text-xl md:hidden">•</span>
            <span class="text-[#4F46E5] text-xl hidden md:inline">✓</span>
            <span data-i18n="finance.detail.feature2"
              >Investment insights and trends</span
            >
          </li>
          <li class="flex items-center gap-3 text-white">
            <span class="text-white text-xl md:hidden">•</span>
            <span class="text-[#4F46E5] text-xl hidden md:inline">✓</span>
            <span data-i18n="finance.detail.feature3"
              >Secure and private transactions</span
            >
          </li>
          <li class="flex items-center gap-3 text-white">
            <span class="text-white text-xl md:hidden">•</span>
            <span class="text-[#4F46E5] text-xl hidden md:inline">✓</span>
            <span data-i18n="finance.detail.feature4">Budgeting made easy</span>
          </li>
        </ul>

                <!-- Download Buttons -->
        <div
          class="apps-badges w-full hidden md:flex flex-col items-center md:items-center gap-6"
        >
          <a href="#" onclick="event.preventDefault(); window.dispatchEvent(new Event('open-coming-soon'));" aria-label="Download on the App Store" class="coming-soon-trigger apps-store-btn" >
            <img
              src="/detailPageImages/app-store-badge.svg"
              alt="Download on the App Store"
            />
          </a>
          <a
            href="https://play.google.com/store/apps/details?id=chat.bemindepower.bmpchat"
            class="apps-store-btn"
            aria-label="Get it on Google Play"
          >
            <img
              src="/detailPageImages/google-play-badge.svg"
              alt="Get it on Google Play"
            />
          </a>
        </div>
      </div>
    </main>

    <!-- Back Arrow Icon -->
    <a
      href="/chat"
      class="hidden md:inline-flex absolute top-20 md:top-[200px] left-4 md:left-40 z-[1001] text-white hover:text-[#4F46E5] transition-colors p-3 border border-transparent hover:border-[#4F46E5]/50 rounded-full bg-white/10 backdrop-blur-sm hover:bg-white/20"
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M19 12H5M12 19L5 12L12 5"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>
</Layout>

<style>
  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-15px);
    }
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  @keyframes shimmer {
    100% {
      transform: translateX(200%);
    }
  }

  .animate-shimmer {
    animation: shimmer 1.5s infinite;
  }

  .store-btn {
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
  }

    /* Apps Buttons Styles */
  @keyframes blink-shadow {
    0%,
    100% {
      box-shadow:
        0 4px 14px rgba(38, 4, 209, 0.7),
        0 -4px 14px rgba(25, 41, 255, 0.9);
    }
    50% {
      box-shadow:
        0 4px 25px rgba(38, 4, 209, 1),
        0 -4px 25px rgba(25, 41, 255, 1);
    }
  }

  .apps-store-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    background: rgba(0, 0, 0, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50px;
    box-shadow:
      0 4px 14px rgba(38, 4, 209, 0.7),
      0 -4px 14px rgba(25, 41, 255, 0.9);
    text-decoration: none;
    transition: transform 0.2s;
    animation: blink-shadow 2s infinite;
  }

  @media (min-width: 768px) {
    .apps-store-btn {
      width: 250px;
      height: 70px;
    }
    .apps-store-btn img {
      height: 50px;
    }
  }

  .apps-store-btn:hover,
  .apps-store-btn:active {
    transform: scale(1.05);
    animation: none;
    box-shadow: 0 6px 20px rgba(55, 27, 190, 0.8);
  }

  .apps-store-btn img {
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  </style>

