<div class="hero-logo-text">
  <img src="/detailPageImages/LOGOBLANCO.svg" alt="BeMind Power" />
</div>

<style>
  .hero-logo-text {
    width: clamp(130px, 14vw, 180px);
    margin-bottom: clamp(6px, 0.8vh, 12px);
    position: relative;
    z-index: 20;
  }

  @media (min-width: 1440px) {
    .hero-logo-text {
      width: clamp(155px, 15vw, 205px);
      margin-bottom: clamp(8px, 1vh, 14px);
    }
  }

  @media (min-width: 1920px) {
    .hero-logo-text {
      width: clamp(170px, 16vw, 220px);
      margin-bottom: clamp(10px, 1.1vh, 16px);
    }
  }

  .hero-logo-text img {
    width: 100%;
    height: auto;
  }

  @media (max-width: 768px) {
    .hero-logo-text {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero-logo-text {
      width: min(105px, 28vw);
      margin-bottom: 1.2vh;
    }
  }

  /* iPhone SE y pantallas muy pequeñas */
  @media (max-width: 375px) {
    .hero-logo-text {
      width: min(95px, 26vw);
      margin-bottom: 1.2vh;
    }
  }
</style>
