---
// Descripción del hero
interface Props {
  text?: string;
}

const {
  text = "<strong>Aquí no solo tienes una app.</strong> Tienes tu red sin complicaciones: escribe, compra, paga, explora y transforma tu día… con la claridad de <strong>Be Mind Power.</strong>",
} = Astro.props;
---

<p
  id="hero-subtitle"
  class="hero-description"
  set:html={text}
  data-i18n-html="home.hero.description"
/>

<style>
  .hero-description {
    color: #ffffff;
    font-family: "Neometric", "Inter", sans-serif;
    font-size: clamp(11px, 1vw, 16px);
    font-weight: 400;
    line-height: 1.25;
    text-align: center;
    margin: 0 0 clamp(12px, 1.5vh, 22px) 0;
    padding: 0 5vw;
    max-width: clamp(550px, 60vw, 750px);
  }

  @media (min-width: 1440px) {
    .hero-description {
      font-size: clamp(12px, 1.1vw, 18px);
      line-height: 1.3;
      margin-bottom: clamp(16px, 1.8vh, 26px);
      max-width: clamp(600px, 62vw, 850px);
    }
  }

  @media (min-width: 1920px) {
    .hero-description {
      font-size: clamp(14px, 1.2vw, 20px);
      line-height: 1.35;
      margin-bottom: clamp(20px, 2vh, 30px);
      max-width: clamp(700px, 58vw, 900px);
    }
  }

  @media (max-width: 768px) {
    .hero-description {
      font-size: 14px;
      line-height: 1.4;
      max-width: 500px;
      margin-bottom: 1.5vh;
    }
  }

  @media (max-width: 480px) {
    .hero-description {
      font-size: 13px;
      padding: 0 6vw;
      line-height: 1.35;
      margin-bottom: 1.5vh;
    }
  }

  /* iPhone SE y pantallas muy pequeñas */
  @media (max-width: 375px) {
    .hero-description {
      font-size: 12px;
      line-height: 1.3;
      margin-bottom: 1.5vh;
      padding: 0 7vw;
    }
  }
</style>
