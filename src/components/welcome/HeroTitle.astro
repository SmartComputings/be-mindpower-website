---
// Título hero
interface Props {
  text?: string;
}

const { text = "A una experiencia sin precedentes" } = Astro.props;
---

<h1 id="hero-title-line2" class="hero-title" data-i18n="home.hero.title">
  {text}
</h1>

<style>
  .hero-title {
    color: #ffffff;
    font-family: "Neometric", "Inter", sans-serif;
    font-size: clamp(13px, 1.6vw, 24px);
    font-weight: 400;
    line-height: 1.25;
    text-align: center;
    margin: 0 0 clamp(6px, 0.8vh, 12px) 0;
    padding: 0 5vw;
  }

  @media (min-width: 1440px) {
    .hero-title {
      font-size: clamp(18px, 1.8vw, 28px);
      line-height: 1.3;
      margin-bottom: clamp(8px, 1vh, 14px);
    }
  }

  @media (min-width: 1920px) {
    .hero-title {
      font-size: clamp(20px, 2vw, 32px);
      line-height: 1.35;
      margin-bottom: clamp(10px, 1.1vh, 16px);
    }
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: clamp(14px, 2.8vw, 21px);
      line-height: 1.35;
      margin-bottom: 3.5vh;
    }
  }

  @media (max-width: 480px) {
    .hero-title {
      font-size: 13px;
      line-height: 1.3;
      margin-bottom: 3.5vh;
      padding: 0 6vw;
    }
  }

  /* iPhone SE y pantallas muy pequeñas */
  @media (max-width: 375px) {
    .hero-title {
      font-size: 12px;
      line-height: 1.3;
      margin-bottom: 2vh;
    }
  }
</style>
