---
import Logo from "./Logo.astro";
import Navigation from "./Navigation.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  currentPath?: string;
  backgroundImage?: string;
  pageTitle?: string;
  pageTitleKey?: string;
}

const {
  currentPath,
  backgroundImage = "/common/headerbg.png",
  pageTitle,
  pageTitleKey,
} = Astro.props;
---

<header class="fixed left-0 right-0 top-6 z-40">
  <!-- Decorative backdrop for header removed for pure transparency on mobile -->

  <div
    class="relative w-full max-w-[1728px] mx-auto px-4 min-[900px]:px-[6.4%]"
  >
    <div class="flex items-center justify-center">
      <div
        class="w-full bg-none min-[900px]:bg-white/5 min-[900px]:rounded-full px-0 min-[900px]:px-8 py-3 min-[900px]:border min-[900px]:border-white/10 min-[900px]:shadow-[0_8px_40px_rgba(18,12,40,0.6)] min-[900px]:backdrop-blur-md header-container"
      >
        <div
          class="relative flex items-center justify-between w-full max-w-[1400px] mx-auto"
        >
          <!-- Logo -->
          <div
            class="flex items-center min-[900px]:flex-1 justify-center min-[900px]:justify-start absolute left-1/2 -translate-x-1/2 min-[900px]:relative min-[900px]:left-0 min-[900px]:translate-x-0"
          >
            <a
              href="/"
              class="flex items-center gap-2.5 no-underline shrink-0"
              aria-label="BeMind Power - Inicio"
            >
              <picture>
                <source
                  media="(max-width: 899px)"
                  srcset="/common/logos/Logo_Be-Mind%20night.png"
                />
                <img
                  src="/common/logos/Logo_Be-Mind%20night.svg"
                  alt="BeMind Power"
                  class="h-[60px] min-[900px]:h-10 w-auto"
                />
              </picture>
            </a>
          </div>

          <!-- Navigation -->
          <div
            class="min-[900px]:relative min-[900px]:flex-1 flex items-center justify-end min-[900px]:justify-center ml-auto min-[900px]:ml-0"
          >
            <Navigation currentPath={currentPath} />
          </div>

          <!-- Language switcher (replaces Registro/Login buttons) -->
          <div
            class="hidden min-[900px]:flex flex-1 items-center justify-end gap-3"
          >
            <LanguageSwitcher size="md" />
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
