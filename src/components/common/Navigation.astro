---
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const mainNavItems = [{ key: "nav.home", label: "Inicio", href: "/" }];

const aboutItem = {
  key: "nav.about",
  label: "Sobre nosotros",
  href: "/Aboutus",
};

const featureItems = [
  {
    key: "features.chat.title",
    label: "Chat",
    href: "/chat",
    mobileHref: "/chatdetails",
  },
  {
    key: "features.wallet.title",
    label: "Wallet",
    href: "/wallet",
    mobileHref: "/walletdetails",
  },
  {
    key: "features.marketplace.title",
    label: "Marketplace",
    href: "/marketplace",
    mobileHref: "/marketplacedetails",
  },
  {
    key: "features.apps.title",
    label: "Apps",
    href: "/apps",
    mobileHref: "/appsdetails",
  },
  {
    key: "features.nutrition.title",
    label: "Nutrición",
    href: "/nutrition",
    mobileHref: "/nutritiondetails",
  },
  {
    key: "features.communities.title",
    label: "Comunidad",
    href: "/communities",
    mobileHref: "/communitiesdetails",
  },
  {
    key: "features.music.title",
    label: "Música",
    href: "/musica",
    mobileHref: "/musicdetails",
  },
  {
    key: "features.mentalHealth.title",
    label: "Salud Mental",
    href: "/salud-mental",
    mobileHref: "/healthdetails",
  },
  {
    key: "features.finance.title",
    label: "Finanzas",
    href: "/finance",
    mobileHref: "/financedetails",
  },
];

const contactItem = {
  key: "nav.contact",
  label: "Contacto",
  href: "/Contactus",
};

const footerNavItems = [aboutItem, contactItem];

const activeFeature = featureItems.find(
  (item) =>
    currentPath === item.href ||
    ((item as any).mobileHref && currentPath === (item as any).mobileHref),
);
---

<nav class="relative flex items-center gap-8">
  <!-- Main Navigation (Desktop) -->
  <ul class="hidden min-[900px]:flex items-center gap-8">
    {
      mainNavItems.map((item, index) => (
        <li>
          <a
            href={item.href}
            class:list={[
              "py-1 text-[15px] transition-colors duration-300 whitespace-nowrap",
              currentPath === item.href
                ? "font-bold text-white border-b-[1.5px] border-white"
                : "font-light text-white/70 hover:text-white",
              `stagger-${index + 1}`,
            ]}
          >
            {item.key ? (
              <span data-i18n={item.key}>{item.label}</span>
            ) : (
              item.label
            )}
          </a>
        </li>
      ))
    }

    <li class="relative group h-full flex items-center" id="features-dropdown">
      <button
        id="features-trigger"
        class:list={[
          "h-full py-1 text-[15px] transition-colors duration-300 whitespace-nowrap flex items-center gap-1",
          activeFeature
            ? "font-bold text-white border-b-[1.5px] border-white"
            : "font-light text-white/70 hover:text-white",
        ]}
      >
        {
          activeFeature ? (
            <span
              data-i18n={
                activeFeature.key || `nav.${activeFeature.href.substring(1)}`
              }
            >
              {activeFeature.label}
            </span>
          ) : (
            <span data-i18n="nav.features">Features</span>
          )
        }
        <svg
          class="w-3 h-3 transition-transform features-arrow"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 9l-7 7-7-7"></path>
        </svg>
      </button>

      <div
        id="features-menu"
        class="absolute top-full left-1/2 -translate-x-1/2 pt-2 opacity-0 invisible transition-all duration-300 z-50 desktop-dropdown"
      >
        <div
          class="bg-[#120068]/95 backdrop-blur-xl rounded-2xl border border-white/10 p-2 shadow-2xl min-w-[160px]"
        >
          <ul class="flex flex-col gap-1">
            {
              featureItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class:list={[
                      "block px-4 py-2 text-xs rounded-xl transition-colors whitespace-nowrap",
                      currentPath === item.href
                        ? "font-bold bg-white/10 text-white"
                        : "font-light text-white/70 hover:bg-white/5 hover:text-white",
                    ]}
                  >
                    {item.key ? (
                      <span data-i18n={item.key}>{item.label}</span>
                    ) : (
                      item.label
                    )}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </li>

    {
      footerNavItems.map((item, index) => (
        <li>
          <a
            href={item.href}
            class:list={[
              "py-1 text-[15px] transition-colors duration-300 whitespace-nowrap",
              currentPath === item.href
                ? "font-bold text-white border-b-[1.5px] border-white"
                : "font-light text-white/70 hover:text-white",
              `stagger-${mainNavItems.length + 1 + index}`,
            ]}
          >
            {item.key ? (
              <span data-i18n={item.key}>{item.label}</span>
            ) : (
              item.label
            )}
          </a>
        </li>
      ))
    }
  </ul>

  <!-- Mobile Menu Button -->
  <button
    id="mobile-menu-btn"
    class="min-[900px]:hidden p-2 rounded-lg text-white hover:bg-white/10 transition-colors"
    aria-label="Abrir menú"
  >
    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </button>

  <!-- Mobile Menu Dropdown -->
  <div
    id="mobile-menu"
    class="absolute top-full right-[-60px] mt-2 w-64 hidden origin-top-right z-50"
  >
    <div
      class="bg-[#13045D]/100 rounded-2xl w-full p-2 animate-menu-pop shadow-2xl overflow-y-auto max-h-[80vh]"
    >
      <ul class="flex flex-col w-full gap-1">
        <!-- Home -->
        <li>
          <a
            href="/"
            class:list={[
              "flex items-center w-full px-4 py-2 text-sm font-medium rounded-xl transition-colors",
              currentPath === "/"
                ? "bg-white/10 text-white"
                : "text-white/70 hover:bg-white/10 hover:text-white",
            ]}
          >
            <span data-i18n="nav.home">Home</span>
          </a>
        </li>

        <!-- Features (Collapsible) -->
        <li>
          <button
            id="mobile-features-trigger"
            class="flex items-center justify-start gap-2 w-full px-4 py-2 text-sm font-medium rounded-xl text-white/70 hover:bg-white/10 hover:text-white transition-colors group"
          >
            {
              activeFeature ? (
                <span
                  data-i18n={
                    activeFeature.key ||
                    `nav.${activeFeature.href.substring(1)}`
                  }
                >
                  {activeFeature.label}
                </span>
              ) : (
                <span data-i18n="nav.features">Features</span>
              )
            }
            <svg
              id="mobile-features-arrow"
              class="w-4 h-4 transition-transform duration-300"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>

          <div
            id="mobile-features-content"
            class="hidden overflow-hidden transition-all duration-300 pl-4"
          >
            <ul class="flex flex-col gap-1 py-1">
              {
                featureItems.map((item) => (
                  <li>
                    <a
                      href={item.mobileHref || item.href}
                      class:list={[
                        "flex items-center w-full px-4 py-2 text-[13px] font-normal rounded-xl transition-colors",
                        currentPath === item.href ||
                        currentPath === item.mobileHref
                          ? "text-white font-medium shadow-[0_0_15px_rgba(255,255,255,0.1)]"
                          : "text-white/60 hover:bg-white/5 hover:text-white",
                      ]}
                    >
                      {item.key ? (
                        <span data-i18n={item.key}>{item.label}</span>
                      ) : (
                        item.label
                      )}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>

        <!-- About Us -->
        <li>
          <a
            href={aboutItem.href}
            class:list={[
              "flex items-center w-full px-4 py-2 text-sm font-medium rounded-xl transition-colors",
              currentPath === aboutItem.href
                ? "bg-white/10 text-white"
                : "text-white/70 hover:bg-white/10 hover:text-white",
            ]}
          >
            <span data-i18n={aboutItem.key}>{aboutItem.label}</span>
          </a>
        </li>

        <!-- Contact -->
        <li>
          <a
            href={contactItem.href}
            class:list={[
              "flex items-center w-full px-4 py-2 text-sm font-medium rounded-xl transition-colors",
              currentPath === contactItem.href
                ? "bg-white/10 text-white"
                : "text-white/70 hover:bg-white/10 hover:text-white",
            ]}
          >
            <span data-i18n={contactItem.key}>{contactItem.label}</span>
          </a>
        </li>

        <li class="h-px bg-white/10 my-1 mx-2"></li>

        <!-- Language Switcher -->
        <li class="mt-2">
          <LanguageSwitcher size="sm" variant="inline" />
        </li>
      </ul>
    </div>
  </div>
</nav>

<script>
  const initNavigationMenu = () => {
    // --- Mobile Menu Elements ---
    const mobileMenuBtn = document.getElementById("mobile-menu-btn");
    
    // Evitar la inicialización doble durante las transiciones de página de Astro
    if (mobileMenuBtn?.hasAttribute("data-initialized")) return;
    if (mobileMenuBtn) mobileMenuBtn.setAttribute("data-initialized", "true");

    const mobileMenu = document.getElementById("mobile-menu");
    const mobileFeaturesTrigger = document.getElementById(
      "mobile-features-trigger",
    );
    const mobileFeaturesContent = document.getElementById(
      "mobile-features-content",
    );
    const mobileFeaturesArrow = document.getElementById(
      "mobile-features-arrow",
    );

    // --- Desktop Menu Elements ---
    const featuresDropdown = document.getElementById("features-dropdown");
    const featuresTrigger = document.getElementById("features-trigger");
    const featuresMenu = document.getElementById("features-menu");
    const featuresArrow = featuresDropdown?.querySelector(
      ".features-arrow",
    ) as HTMLElement;

    if (!mobileMenuBtn || !mobileMenu) return;

    // --- Mobile Menu Logic ---
    const toggleMobileMenu = (e: Event) => {
      e.stopPropagation();
      mobileMenu.classList.toggle("hidden");
    };

    const closeMobileMenu = () => {
      if (!mobileMenu.classList.contains("hidden")) {
        mobileMenu.classList.add("hidden");
        if (mobileFeaturesContent)
          mobileFeaturesContent.classList.add("hidden");
        if (mobileFeaturesArrow) mobileFeaturesArrow.style.transform = "";
      }
    };

    if (mobileFeaturesTrigger && mobileFeaturesContent && mobileFeaturesArrow) {
      mobileFeaturesTrigger.addEventListener("click", (e) => {
        e.stopPropagation();
        const isHidden = mobileFeaturesContent.classList.contains("hidden");
        if (isHidden) {
          mobileFeaturesContent.classList.remove("hidden");
          mobileFeaturesArrow.style.transform = "rotate(180deg)";
        } else {
          mobileFeaturesContent.classList.add("hidden");
          mobileFeaturesArrow.style.transform = "";
        }
      });
    }

    mobileMenuBtn.addEventListener("click", toggleMobileMenu);

    // --- Desktop Dropdown Logic (for touch & reliable click) ---
    if (featuresTrigger && featuresMenu && featuresDropdown) {
      featuresTrigger.addEventListener("click", (e) => {
        // Only toggle via JS if we are likely on a touch device or to provide persistent open
        e.stopPropagation();
        const isOpen = featuresDropdown.classList.contains("is-open");

        // Close other menus if any
        closeMobileMenu();

        if (isOpen) {
          featuresDropdown.classList.remove("is-open");
          if (featuresArrow) featuresArrow.style.transform = "";
        } else {
          featuresDropdown.classList.add("is-open");
          if (featuresArrow) featuresArrow.style.transform = "rotate(180deg)";
        }
      });

      // Prevent closing when clicking inside the menu
      featuresMenu.addEventListener("click", (e) => {
        e.stopPropagation();
      });
    }

    // --- Global Close Logic ---
    document.addEventListener("click", (event) => {
      const target = event.target as Node;

      // Close mobile menu if clicking outside
      if (!mobileMenu.contains(target) && !mobileMenuBtn.contains(target)) {
        closeMobileMenu();
      }

      // Close desktop menu if clicking outside
      if (featuresDropdown && !featuresDropdown.contains(target)) {
        featuresDropdown.classList.remove("is-open");
        if (featuresArrow) featuresArrow.style.transform = "";
      }
    });

    // Close on link click
    document.querySelectorAll("nav a").forEach((link) => {
      link.addEventListener("click", () => {
        closeMobileMenu();
        if (featuresDropdown) {
          featuresDropdown.classList.remove("is-open");
          if (featuresArrow) featuresArrow.style.transform = "";
        }
      });
    });
  };

  document.addEventListener("astro:page-load", initNavigationMenu);
</script>

<style>
  @keyframes menu-pop {
    0% {
      opacity: 0;
      transform: scale(0.95) translateX(20px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateX(0);
    }
  }

  .animate-menu-pop {
    animation: menu-pop 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* Desktop Dropdown Open State (for JS toggle) */
  #features-dropdown.is-open #features-menu {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translate(-50%, 0) !important;
    top: 100% !important;
  }

  /* Hover Bridge: ensures there's no gap for the mouse to cross */
  .desktop-dropdown::before {
    content: "";
    position: absolute;
    top: -15px;
    left: 0;
    right: 0;
    height: 20px;
    background: transparent;
    z-index: -1;
  }
</style>
